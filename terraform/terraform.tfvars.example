project_name         = "yt-dlp-music"
aws_region           = "ap-northeast-1"
# aws_profile        = "my-aws-profile"  # ~/.aws/credentials のプロファイル名
presigned_url_expiry = 3600
lambda_image_tag     = "latest"

# 本番ではフロントのオリジンを指定（例: https://example.com）
cors_allowed_origins = ["*"]

lambda_timeout   = 300
lambda_memory_mb = 2048
s3_lifecycle_days = 1
